# PostgreSQL connection string used by the application backend.
# Recommended: a pooled connection string from Neon, Supabase, or RDS.
# Local example: postgres://postgres:postgres@localhost:5432/ics_admissions
DATABASE_URL=

# Passcode for the Staff Console at /admin (admissions office only).
# Choose something strong — it guards all application/student data.
ADMIN_PASSCODE=

